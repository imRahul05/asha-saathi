# ASHA Saathi: copy to .env.local (never commit .env.local) and set the same names in Vercel.

# --- Agora (required) ---------------------------------------------------------------------------
# Agora Console -> your project -> App ID / App Certificate. The certificate is server-side only.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# --- Database (required): Neon Postgres ----------------------------------------------------------
# Vercel project -> Storage -> Create -> Neon (free) -> it adds DATABASE_URL. Then run:
#   pnpm db:migrate && pnpm db:seed
# A URL pointing at localhost uses a normal Postgres connection (handy for local development).
DATABASE_URL=

# --- Voice (required) ----------------------------------------------------------------------------
# Murf Falcon is the text-to-speech voice (bring your own key). Without these the agent falls back to a generic voice.
MURF_API_KEY=
MURF_VOICE_ID=Pooja

# --- Tool server security (required) -------------------------------------------------------------
# Agora's AI calls our /api/mcp with this secret. Generate: openssl rand -hex 24
MCP_SHARED_SECRET=
# The PUBLIC https URL of this app. Agora cannot reach localhost, so for local dev use a tunnel URL or a deployed URL.
PUBLIC_BASE_URL=

# --- Optional ------------------------------------------------------------------------------------
# Signs the demo-session cookie. Defaults to MCP_SHARED_SECRET if unset. Generate: openssl rand -hex 32
SESSION_SECRET=
# Usage guard (defaults shown): protects the 300 free Agora agent-minutes
AGENT_STARTS_PER_ASHA_HOUR=6
AGENT_STARTS_PER_IP_HOUR=12
AGENT_STARTS_PER_DAY=80
DEMO_SIGNINS_PER_IP_HOUR=15
# Protects the projector dashboard (/dashboard?key=...). Set it in production: it shows real patient data.
DASHBOARD_KEY=
# Managed model: gpt-4o-mini (default), gpt-4.1-mini, gpt-5-nano, gpt-5-mini
LLM_MODEL=gpt-4o-mini
# Languages the speech recogniser listens for (comma list)
ASR_LANGUAGES=hi-IN,kn-IN,en-IN
# Alerts: console (log only, default), twilio (WhatsApp then SMS), or multi (Telegram, then WhatsApp, then SMS).
NOTIFIER=console
# Telegram: create a bot with @BotFather, tap Start in it, then run `pnpm telegram:setup` to save TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender (the doctor's phone must have sent the join phrase; it lapses after 3 days)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your Twilio number, E.164 (+1...). Used for the SMS fallback. Trial accounts can only text verified numbers.
TWILIO_PHONE_NUMBER=
# Order to try (default whatsapp,sms). Use sms alone if you do not want WhatsApp.
TWILIO_CHANNELS=whatsapp,sms
# Seeding (pnpm db:seed): the phone that receives alerts, E.164 format
SEED_DOCTOR_PHONE=
SEED_DOCTOR_NAME=Dr. Rao
